# ─────────────────────────────────────────────────────────────────
# .env.example  –  Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Deployment tokens (required for deploy.ps1) ───────────────────
# Supabase Personal Access Token → https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub remains optional for source control only. Trading no longer runs on GitHub Actions.
GITHUB_REPOSITORY=owandakin-coder/agent-analyst
ATZMA_BROKER_CREDENTIAL_KEY=encrypt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ATZMA_WORKER_SHARED_TOKEN=worker_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ATZMA_FAIL_CLOSED_CONTROL=1
ATZMA_ALLOW_LOCAL_CONTROL_FALLBACK=0
ATZMA_REQUIRE_FRESH_QUOTES=1
ATZMA_WORKER_POLL_SECONDS=10
ATZMA_WORKER_LEASE_SECONDS=90
ATZMA_RECONCILE_INTERVAL_SECONDS=30
ATZMA_JSON_LOGS=1

# ── Alpaca Paper Trading (safe for testing – no real money) ───────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpaca Live Trading (DANGER – real money)
# Uncomment and fill ONLY when you fully understand the risks.
# ALPACA_BASE_URL=https://api.alpaca.markets

# ── Optional: Telegram bot for order approval notifications ───────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional remote API override for isolated workers
ATZMA_REMOTE_API_BASE=https://sofowpweliticltlbxrj.supabase.co/functions/v1/api
